# Frontend (public — exposed to browser; anon key is safe only with RLS)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY
VITE_APP_TIMEZONE=Asia/Bangkok
VITE_DEFAULT_LOCALE=th
# Optional UX hint for Google account chooser (real check is in the DB, ADR-0006)
VITE_GOOGLE_HOSTED_DOMAIN=

# Server-only (Supabase Edge Function secrets — NEVER prefix with VITE_)
# SUPABASE_SERVICE_ROLE_KEY=
# GEMINI_API_KEY=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# CI only (GitHub Actions secrets)
# SUPABASE_DB_URL=
# BACKUP_AGE_PUBLIC_KEY=
